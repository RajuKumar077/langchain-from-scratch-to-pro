# ==============================================================================
# Model Context Protocol (MCP) + Local Ollama & LangSmith Configuration
# ==============================================================================

# LangSmith Tracing & Observability (Optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=mcp-learning-exercises
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Local Ollama Inference (100% Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# MCP Remote / SSE Server Settings
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8080
