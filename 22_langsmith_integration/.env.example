# ==============================================================================
# LangSmith & Environment Configuration
# ==============================================================================

# 1. Enable LangSmith Tracing (Required)
LANGCHAIN_TRACING_V2=true
# Or alternative env var: LANGSMITH_TRACING=true

# 2. Your LangSmith API Key (Get from https://smith.langchain.com -> Settings -> API Keys)
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here

# 3. LangSmith Project Name (Groups your runs together in the dashboard)
LANGCHAIN_PROJECT=langchain-book-demo

# 4. LangSmith API Endpoint (Default for US cloud)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 5. LLM API Keys (Depending on model provider used)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# If using local Ollama, no extra API key is needed.
